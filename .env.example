# ============================================================
# SUNKEY WEBSITE — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# Set all variables in Vercel Dashboard > Settings > Environment Variables.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────
# Get this from https://console.neon.tech — append ?sslmode=require
DATABASE_URI=postgresql://user:password@host/db?sslmode=require

# ── Payload CMS ───────────────────────────────────────────
# Minimum 32 characters, generated randomly.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-32-char-minimum-random-string

# ── Site URL ──────────────────────────────────────────────
# Production domain — must NOT have a trailing slash.
# In development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://sunkeydesignsystems.com

# ── Resend (Email delivery) ───────────────────────────────
# Create an account at https://resend.com
# Create an API key under API Keys in the Resend dashboard.
# Add and verify sunkeydesignsystems.com as a sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Tag Manager ────────────────────────────────────
# Get your GTM container ID from https://tagmanager.google.com
# Format: GTM-XXXXXXX
# Leave blank to disable GTM (development / staging)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Seed secret ───────────────────────────────────────────
# Used to protect the POST /api/seed endpoint.
# Generate randomly — treat like a password.
# Remove or leave blank after initial seeding is complete.
SEED_SECRET=replace-with-random-string-for-seeding
